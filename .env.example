# Vorlage fuer die .env-Datei neben der docker-compose.yml.
#
#   cp .env.example .env    und danach beide Werte ersetzen.
#
# WICHTIG: Diese beiden Passwoerter greifen NUR beim allerersten Start, wenn
# noch keine data/stammbaum.db existiert. Sie werden dabei gehasht (scrypt) in
# die Tabelle `settings` geschrieben. Ab dann sind die Werte hier wirkungslos -
# geaendert werden die Passwoerter im Admin-Bereich der App
# (Admin -> Passwoerter, verlangt immer das aktuelle Admin-Passwort).
#
# Bitte starke, unterschiedliche Passwoerter setzen. Vorschlag zum Erzeugen:
#   openssl rand -base64 18
#
# Mindestens 12 Zeichen - dieselbe Untergrenze gilt spaeter im Adminbereich.
# Die App ist ueber das Internet erreichbar und enthaelt Daten von Kindern;
# das Familien-Passwort ist die einzige Huerde davor. Kein Wort aus dem
# Woerterbuch, kein Familienname, keine Jahreszahl.
#
# Fehlt eine der beiden Variablen beim allerersten Start, erzeugt die App
# selbst ein zufaelliges Passwort und schreibt es einmalig ins Log
# (`docker compose logs stammbaum`). Ein fest eingebautes Standardpasswort
# gibt es bewusst nicht mehr.

# Zugang zur App fuer die ganze Familie
INITIAL_FAMILY_PASSWORD=hier-ein-starkes-familien-passwort

# Zusaetzlicher Zugang zum Admin-Bereich (Fotos hochladen, Personen loeschen)
INITIAL_ADMIN_PASSWORD=hier-ein-anderes-starkes-admin-passwort
